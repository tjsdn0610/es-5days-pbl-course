# 프로야구 선수 index 생성. 개인 루트는 elasticsearch/index-create.json이다.
# 이미 만든 index에는 이 PUT을 다시 실행하지 않는다. 없을 때만 생성한다.
# index 이름과 properties가 my-data-settings.ps1의 field 이름·Kind와 맞는지 먼저 확인합니다.
PUT /kbo-players
{
  "settings": { "number_of_shards": 1, "number_of_replicas": 1 },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "P_ID": { "type": "keyword" },
      "P_NM": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "TEAM_NM": { "type": "keyword" },
      "P_TYPE": { "type": "keyword" },
      "POSITION": { "type": "keyword" },
      "STATUS": { "type": "keyword" },
      "SEASON": { "type": "integer" },
      "G": { "type": "integer" },
      "AVG": { "type": "float" },
      "HR": { "type": "integer" },
      "RBI": { "type": "integer" },
      "SB": { "type": "integer" },
      "OPS": { "type": "float" },
      "ERA": { "type": "float" },
      "W": { "type": "integer" },
      "SV": { "type": "integer" },
      "SO": { "type": "integer" },
      "WHIP": { "type": "float" },
      "profile": { "type": "text" }
    }
  }
}
GET /kbo-players/_mapping
