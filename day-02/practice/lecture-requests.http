# Day 2 69장 수업의 공통 실행 요청. 파일을 통째로 실행하지 않습니다.
# 요청 하나씩 Kibana Dev Tools Console에 복사합니다.
# S32 전체 생성 요청: ../data/requests/01-create-products.http (없을 때만 PUT).
# S33 개인 index: 자기 elasticsearch/index-create.json과 requests.http 사용.

### V1-T09-C · S8 기본 표
GET /_cat/nodes?v

### V1-T09-C · S8 노드와 버전
GET /_cat/nodes?v&h=name,ip,node.role,master,version

### S9 현재 index 목록: products 존재나 10000건을 가정하지 않음
GET /_cat/indices?v

### S39 실제 field 설정의 분석기
POST /products/_analyze
{"field":"name","text":"SoundLab 무선 이어폰"}

### S40~41 standard 직접 지정
POST /_analyze
{"analyzer":"standard","text":"SoundLab 무선 이어폰"}

### S45 출발 count
GET /products/_count

### S45 ID 부재 확인. found:true면 중단하고 모든 P-0001을 미사용 ID로 변경
GET /products/_doc/P-0001

### S46 최초 생성만 허용. 409면 기존 문서를 지우지 말 것
PUT /products/_doc/P-0001?op_type=create&refresh=wait_for
{
  "product_id":"P-0001",
  "name":"SoundLab 무선 이어폰",
  "category":"이어폰",
  "brand":"SoundLab",
  "price":89000,
  "in_stock":true,
  "rating":4.6,
  "tags":["무선","블루투스","가성비"],
  "created_at":"2025-08-30T10:00:00Z"
}

### S47 설명만. update를 미리 실행하지 않음
### S48 조회만 (S46의 PUT 재실행 금지)
GET /products/_doc/P-0001

### S49 price만 수정
POST /products/_update/P-0001?refresh=wait_for
{"doc":{"price":79000}}

### S49 수정 후 조회
GET /products/_doc/P-0001

### S50 이 수업에서 직접 생성한 임시 문서만 삭제
DELETE /products/_doc/P-0001?refresh=wait_for

### S50 삭제 후 조회: 404, found:false
GET /products/_doc/P-0001

### S52 출발 count와 비교 (10000건 고정 아님)
GET /products/_count

### S58 공통 적재 후 count
GET /products/_count

### S58 분포 검증. 그림 막대 대신 실제 JSON 값을 기록
GET /products/_search
{
  "size":0,
  "aggs":{
    "category_count":{"terms":{"field":"category","size":20}},
    "stock_count":{"terms":{"field":"in_stock","size":2}},
    "price_stats":{"stats":{"field":"price"}},
    "created_min":{"min":{"field":"created_at","format":"strict_date_time"}},
    "created_max":{"max":{"field":"created_at","format":"strict_date_time"}}
  }
}

### S63 기존 정의 확인. 다른 정의가 있으면 덮어쓰지 말고 새 이름 사용
GET /_ingest/pipeline/product-cleanup

### S63 없는 경우만 정의
PUT /_ingest/pipeline/product-cleanup
{
  "description":"상품 문서 정리",
  "processors":[
    {"set":{"field":"in_stock","value":true,"override":false}},
    {"rename":{"field":"brand_name","target_field":"brand"}},
    {"remove":{"field":["temp","raw_price"]}}
  ]
}

### S64 Samsung. simulate는 저장하지 않음
POST /_ingest/pipeline/product-cleanup/_simulate
{
  "docs":[{"_source":{
    "product_id":"P-0001","name":"삼성 갤럭시 S24","price":599000,
    "brand_name":"Samsung","temp":"임시","raw_price":"599,000"
  }}]
}

### S65 Apple
POST /_ingest/pipeline/product-cleanup/_simulate
{
  "docs":[{"_source":{
    "product_id":"P-0001","name":"아이폰 15 Pro Max","category":"전자기기","price":1590000,
    "brand_name":"Apple","raw_price":"1,590,000","temp":"임시"
  }}]
}

### S65 추가: false 유지
POST /_ingest/pipeline/product-cleanup/_simulate
{
  "docs":[{"_source":{
    "name":"실험","price":10000,"in_stock":false,
    "brand_name":"Apple","raw_price":"10,000","temp":"임시"
  }}]
}

### S65 추가: temp 누락에 따른 오류 관찰. 실제 저장 없음
POST /_ingest/pipeline/product-cleanup/_simulate
{
  "docs":[{"_source":{
    "name":"실험","price":10000,"brand_name":"Apple","raw_price":"10,000"
  }}]
}

# S67 개인 선택 구현의 path 형태 (아래 예시 문자열 자체를 실행하지 않음):
# PUT /자기-index/_doc/미사용-임시-id?pipeline=자기-pipeline&op_type=create&refresh=wait_for
# body는 자기 pipeline 입력에 맞고, 변환 출력은 자기 mapping과 맞아야 함.
# GET으로 확인 후 자신이 만든 임시 ID만 DELETE하고 count 재확인.
